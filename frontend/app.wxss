page {
  background: #f6f7f9;
  color: #1f2933;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #77818c;
}

.card {
  background: #ffffff;
  border: 1rpx solid #edf0f2;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 41, 51, 0.05);
}

.primary-button {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #1f8a70;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.ghost-button {
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #edf8f4;
  color: #1f8a70;
  font-size: 28rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: #eef3f1;
  color: #426158;
  font-size: 24rpx;
}
