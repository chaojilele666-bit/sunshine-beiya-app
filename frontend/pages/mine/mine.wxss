.mine-page {
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

.user {
  display: flex;
  align-items: center;
  padding: 28rpx;
  box-sizing: border-box;
}

.user-avatar {
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 104rpx;
  line-height: 104rpx;
  margin-right: 20rpx;
  border-radius: 52rpx;
  background: #1f8a70;
  color: #ffffff;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
}

.user-avatar.ayi-avatar {
  background: #315b7c;
}

.user-avatar-image {
  display: block;
  line-height: normal;
  background: #edf8f4;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.user-name {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.login-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.login-status-title {
  margin-bottom: 6rpx;
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 800;
}

.login-status-button {
  flex: 0 0 auto;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.message-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.message-entry-title {
  margin-bottom: 6rpx;
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 800;
}

.message-entry-right {
  display: flex;
  align-items: center;
}

.message-badge {
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  margin-right: 14rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #f04438;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
}

.message-arrow {
  color: #9aa4b2;
  font-size: 42rpx;
  line-height: 1;
}

.choose-button {
  margin-top: 28rpx;
}

.status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 24rpx;
}

.status-title {
  color: #35424d;
  font-weight: 800;
}

.status-value {
  color: #1f8a70;
  font-weight: 800;
}

.profile-alert {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  background: #fff7fa;
  border-color: #f4d5de;
  box-sizing: border-box;
}

.alert-title {
  margin-bottom: 6rpx;
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 800;
}

.review-button {
  height: 56rpx;
  line-height: 56rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
}

.tools-section {
  margin-top: 24rpx;
}

.tool-list {
  display: flex;
  flex-wrap: wrap;
}

.tool {
  display: flex;
  align-items: center;
  width: 48.5%;
  min-height: 104rpx;
  margin-right: 3%;
  margin-bottom: 16rpx;
  padding: 18rpx;
  text-align: left;
  box-sizing: border-box;
}

.tool:nth-child(2n) {
  margin-right: 0;
}

.tool-title {
  font-size: 27rpx;
  font-weight: 800;
}

.tool-icon {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  color: #ffffff;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
}

.tool-image {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  background: #edf8f4;
}

.tool-text {
  flex: 1;
  min-width: 0;
}

.tool-icon.pink {
  background: #f59ab0;
}

.tool-icon.green {
  background: #58c89b;
}

.tool-icon.blue {
  background: #6da7e8;
}

.tool-icon.yellow {
  background: #f0bd4f;
}

.tool-icon.cyan {
  background: #58c9d6;
}

.tool-icon.purple {
  background: #a98be8;
}

.banner-card {
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff4f7 0%, #fff6e9 100%);
  color: #35424d;
  font-size: 30rpx;
  font-weight: 800;
}

.banner-button {
  height: 64rpx;
  line-height: 64rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.empty {
  padding: 36rpx 28rpx;
  text-align: center;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  min-height: 84rpx;
  margin-top: 28rpx;
  padding: 0;
  line-height: normal;
  box-sizing: border-box;
  text-align: center;
  border-radius: 42rpx;
}

.empty-button::after {
  border: none;
}

.appointment {
  margin-bottom: 18rpx;
  padding: 26rpx;
}

.appointment-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.appointment-name {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
  word-break: break-all;
}

.status {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 18rpx;
  background: #edf8f4;
  color: #1f8a70;
  font-size: 22rpx;
}

.note {
  margin-top: 12rpx;
  color: #35424d;
  line-height: 1.55;
}

.created {
  margin-top: 16rpx;
  color: #a0a8b1;
  font-size: 24rpx;
}
