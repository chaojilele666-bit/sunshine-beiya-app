.user {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
}

.user-avatar {
  width: 112rpx;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 52rpx;
  background: #1f8a70;
  color: #ffffff;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
}

.user-avatar.ayi-avatar {
  background: #315b7c;
}

.user-name {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.choose-button {
  margin-top: 28rpx;
}

.status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 24rpx;
}

.status-title {
  color: #35424d;
  font-weight: 800;
}

.status-value {
  color: #1f8a70;
  font-weight: 800;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 22rpx;
}

.tool {
  padding: 26rpx 12rpx;
  text-align: center;
}

.tool-title {
  font-size: 28rpx;
  font-weight: 800;
}

.tool-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 auto 16rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.tool-icon.pink {
  background: #f59ab0;
}

.tool-icon.green {
  background: #58c89b;
}

.tool-icon.blue {
  background: #6da7e8;
}

.tool-icon.yellow {
  background: #f0bd4f;
}

.tool-icon.cyan {
  background: #58c9d6;
}

.tool-icon.purple {
  background: #a98be8;
}

.banner-card {
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff4f7 0%, #fff6e9 100%);
  color: #35424d;
  font-size: 30rpx;
  font-weight: 800;
}

.empty {
  padding: 36rpx 28rpx;
  text-align: center;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-button {
  margin-top: 28rpx;
}

.appointment {
  margin-bottom: 18rpx;
  padding: 26rpx;
}

.appointment-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.appointment-name {
  font-size: 32rpx;
  font-weight: 800;
}

.status {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 18rpx;
  background: #edf8f4;
  color: #1f8a70;
  font-size: 22rpx;
}

.note {
  margin-top: 12rpx;
  color: #35424d;
  line-height: 1.55;
}

.created {
  margin-top: 16rpx;
  color: #a0a8b1;
  font-size: 24rpx;
}
