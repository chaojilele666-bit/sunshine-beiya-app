<view class="page mine-page">
  <view wx:if="{{topVisible !== false}}" class="user card">
    <image wx:if="{{displayLogo}}" class="user-avatar user-avatar-image" src="{{displayLogo}}" mode="aspectFit" />
    <view wx:else class="user-avatar {{isAyi ? 'ayi-avatar' : ''}}">{{avatarText}}</view>
    <view class="user-main">
      <view class="user-name">{{pageTitle}}</view>
      <view class="muted">当前身份：{{roleText}}</view>
      <view class="muted">{{pageDesc}}</view>
    </view>
  </view>

  <view class="login-status card">
    <view>
      <view class="login-status-title">{{isLoggedIn ? '已登录' : '未登录'}}</view>
      <view class="muted">
        {{isLoggedIn ? '最近登录方式：' + (authUser.lastLoginMethod || '微信小程序') : '登录后可同步保存注册与最近登录信息'}}
      </view>
    </view>
    <button wx:if="{{!isLoggedIn}}" class="ghost-button login-status-button" bindtap="goLogin">去登录</button>
  </view>

  <view class="message-entry card" bindtap="goMessages">
    <view>
      <view class="message-entry-title">消息中心</view>
      <view class="muted">业务提醒、面试安排和审核结果</view>
    </view>
    <view class="message-entry-right">
      <view wx:if="{{unreadCount > 0}}" class="message-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      <view class="message-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{noRole}}" class="section tools-section">
    <view class="section-title">常用功能</view>
    <view class="tool-list">
      <view class="tool card" bindtap="switchRole">
        <view class="tool-icon purple">选</view>
        <view class="tool-text">
          <view class="tool-title">选择身份</view>
          <view class="muted">客户 / 阿姨</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{isCustomer}}" class="section tools-section">
    <view class="section-title">常用功能</view>
    <view class="tool-list">
      <view
        wx:for="{{customerShortcuts}}"
        wx:key="id"
        class="tool card"
        bindtap="handleShortcut"
        data-item="{{item}}"
      >
        <image wx:if="{{item.displayIcon}}" class="tool-image" src="{{item.displayIcon}}" mode="aspectFit" />
        <view wx:else class="tool-icon {{item.iconClass}}">{{item.iconText}}</view>
        <view class="tool-text">
          <view class="tool-title">{{item.title}}</view>
          <view class="muted">{{item.description}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{isAyi && ayiReviewConfig.visible !== false}}" class="profile-alert card">
    <view>
      <view class="alert-title">{{ayiReviewConfig.title}}</view>
      <view class="muted">{{reviewMessage}}</view>
      <button class="ghost-button review-button" bindtap="goProfile">{{ayiReviewConfig.buttonText}}</button>
    </view>
    <view class="status-value">{{profileStatus}}</view>
  </view>

  <view wx:if="{{isAyi}}" class="section tools-section">
    <view class="section-title">常用功能</view>
    <view class="tool-list">
      <view
        wx:for="{{ayiShortcuts}}"
        wx:key="id"
        class="tool card"
        bindtap="handleShortcut"
        data-item="{{item}}"
      >
        <image wx:if="{{item.displayIcon}}" class="tool-image" src="{{item.displayIcon}}" mode="aspectFit" />
        <view wx:else class="tool-icon {{item.iconClass}}">{{item.iconText}}</view>
        <view class="tool-text">
          <view class="tool-title">{{item.title}}</view>
          <view class="muted">{{item.description}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{isCustomer && customerTip.visible !== false}}" class="banner-card">{{customerTip.text}}</view>

  <view wx:if="{{isAyi && ayiTip.visible !== false}}" class="banner-card">
    <view>{{ayiTip.text}}</view>
    <button class="ghost-button banner-button" bindtap="handleShortcut" data-item="{{ayiTip}}">{{ayiTip.buttonText}}</button>
  </view>

  <view wx:if="{{isCustomer && customerDemandSection.visible !== false}}" class="section">
    <view class="section-title">{{customerDemandSection.title}}</view>
    <view wx:if="{{noDemands}}" class="empty card">
      <view class="empty-title">{{customerDemandSection.emptyTitle}}</view>
      <view class="muted">{{customerDemandSection.emptyDescription}}</view>
      <button class="primary-button empty-button" bindtap="goDemand">{{customerDemandSection.buttonText}}</button>
    </view>
    <view wx:for="{{demands}}" wx:key="id" class="appointment card" bindtap="goDemandDetail" data-id="{{item.id}}">
      <view class="appointment-top">
        <view class="appointment-name">{{item.serviceType}}</view>
        <view class="status">{{item.status}}</view>
      </view>
      <view class="muted">联系人：{{item.name}} {{item.phone}}</view>
      <view class="muted">上户时间：{{item.startTime}}</view>
      <view class="muted">地址：{{item.city}} {{item.address}}</view>
      <view class="note">家庭情况：{{item.familyInfo}}</view>
      <view class="created">提交时间：{{item.createdAt}}</view>
    </view>
  </view>

  <view wx:if="{{isCustomer && customerAppointmentSection.visible !== false}}" class="section">
    <view class="section-title">{{customerAppointmentSection.title}}</view>
    <view wx:if="{{noAppointments}}" class="empty card">
      <view class="empty-title">{{customerAppointmentSection.emptyTitle}}</view>
      <view class="muted">{{customerAppointmentSection.emptyDescription}}</view>
      <button class="primary-button empty-button" bindtap="goList">{{customerAppointmentSection.buttonText}}</button>
    </view>
    <view wx:for="{{appointments}}" wx:key="id" class="appointment card">
      <view class="appointment-top">
        <view class="appointment-name">{{item.ayiName}} · {{item.role}}</view>
        <view class="status">{{item.status}}</view>
      </view>
      <view class="muted">联系人：{{item.name}} {{item.phone}}</view>
      <view class="muted">面试时间：{{item.date}}</view>
      <view class="muted">地址：{{item.address}}</view>
      <view class="created">提交时间：{{item.createdAt}}</view>
    </view>
  </view>

  <view wx:if="{{isAyi && ayiApplicationSection.visible !== false}}" class="section">
    <view class="section-title">{{ayiApplicationSection.title}}</view>
    <view wx:if="{{noApplications}}" class="empty card">
      <view class="empty-title">{{ayiApplicationSection.emptyTitle}}</view>
      <view class="muted">{{ayiApplicationSection.emptyDescription}}</view>
      <button class="primary-button empty-button" bindtap="goHall">{{ayiApplicationSection.buttonText}}</button>
    </view>
    <view wx:for="{{applications}}" wx:key="id" class="appointment card">
      <view class="appointment-top">
        <view class="appointment-name">{{item.serviceType}}</view>
        <view class="status">{{item.status}}</view>
      </view>
      <view class="muted">地址：{{item.customerAddress}}</view>
      <view class="muted">上户时间：{{item.startTime}}</view>
      <view class="muted">预算：{{item.budget}}</view>
      <view class="note">家庭情况：{{item.familyInfo}}</view>
      <view class="created">申请时间：{{item.createdAt}}</view>
    </view>
  </view>
</view>
