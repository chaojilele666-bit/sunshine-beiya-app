<view class="page mine-page">
  <view class="user card">
    <view class="user-avatar">{{avatarText}}</view>
    <view class="user-main">
      <view class="user-name">{{pageTitle}}</view>
      <view class="muted">当前身份：{{roleText}}</view>
      <view class="muted">{{pageDesc}}</view>
    </view>
  </view>

  <view wx:if="{{isAyi}}" class="profile-alert card">
    <view>
      <view class="alert-title">资料状态</view>
      <view class="muted">资料越完整，越容易获得面试机会。</view>
    </view>
    <view class="status-value">{{profileStatus}}</view>
  </view>

  <view class="section tools-section">
    <view class="section-title">常用功能</view>
    <view class="tool-list">
      <view wx:if="{{noRole}}" class="tool card" bindtap="switchRole">
        <view class="tool-icon purple">选</view>
        <view class="tool-text">
          <view class="tool-title">选择身份</view>
          <view class="muted">客户 / 阿姨</view>
        </view>
      </view>

      <view wx:if="{{isCustomer}}" class="tool card" bindtap="goDemand">
      <view class="tool-icon pink">需</view>
        <view class="tool-text">
          <view class="tool-title">发布需求</view>
          <view class="muted">填写家庭服务需求</view>
        </view>
      </view>
      <view wx:if="{{isCustomer}}" class="tool card" bindtap="goList">
      <view class="tool-icon green">找</view>
        <view class="tool-text">
          <view class="tool-title">找阿姨</view>
          <view class="muted">查看可预约阿姨</view>
        </view>
      </view>

      <view wx:if="{{isAyi}}" class="tool card" bindtap="goProfile">
      <view class="tool-icon pink">简</view>
        <view class="tool-text">
          <view class="tool-title">我的资料</view>
          <view class="muted">经验、薪资、服务类型</view>
        </view>
      </view>
      <view wx:if="{{isAyi}}" class="tool card" bindtap="goCerts">
      <view class="tool-icon green">证</view>
        <view class="tool-text">
          <view class="tool-title">我的证件</view>
          <view class="muted">身份证、健康证、技能证书</view>
        </view>
      </view>
      <view wx:if="{{isAyi}}" class="tool card" bindtap="goHall">
      <view class="tool-icon blue">单</view>
        <view class="tool-text">
          <view class="tool-title">找工作</view>
          <view class="muted">查看客户需求</view>
        </view>
      </view>
      <view wx:if="{{isAyi}}" class="tool card" bindtap="goApplications">
      <view class="tool-icon yellow">接</view>
        <view class="tool-text">
          <view class="tool-title">我的接单</view>
          <view class="muted">查看申请记录</view>
        </view>
      </view>
    </view>
  </view>

  <view class="assist-list card">
    <view class="assist-row" bindtap="callService">
      <view>
        <view class="assist-title">联系客服</view>
        <view class="muted">电话沟通服务问题</view>
      </view>
      <view class="assist-arrow">›</view>
    </view>
    <view class="assist-row" bindtap="switchRole">
      <view>
        <view class="assist-title">切换身份</view>
        <view class="muted">客户 / 阿姨身份切换</view>
      </view>
      <view class="assist-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{isCustomer}}" class="banner-card">服务顾问会根据地址、预算和家庭情况推荐合适阿姨</view>

  <view wx:if="{{isCustomer}}" class="section">
    <view class="section-title">我的需求</view>
    <view wx:if="{{noDemands}}" class="empty card">
      <view class="empty-title">还没有发布需求</view>
      <view class="muted">填写家庭情况后，顾问会帮你推荐合适阿姨。</view>
      <button class="primary-button empty-button" bindtap="goDemand">发布需求</button>
    </view>
    <view wx:for="{{demands}}" wx:key="id" class="appointment card">
      <view class="appointment-top">
        <view class="appointment-name">{{item.serviceType}}</view>
        <view class="status">{{item.status}}</view>
      </view>
      <view class="muted">联系人：{{item.name}} {{item.phone}}</view>
      <view class="muted">上户时间：{{item.startTime}}</view>
      <view class="muted">地址：{{item.city}} {{item.address}}</view>
      <view class="note">家庭情况：{{item.familyInfo}}</view>
      <view class="created">提交时间：{{item.createdAt}}</view>
    </view>
  </view>

  <view wx:if="{{isCustomer}}" class="section">
    <view class="section-title">我的预约</view>
    <view wx:if="{{noAppointments}}" class="empty card">
      <view class="empty-title">还没有预约</view>
      <view class="muted">先看看合适的阿姨，提交后顾问会联系确认。</view>
      <button class="primary-button empty-button" bindtap="goList">去找阿姨</button>
    </view>
    <view wx:for="{{appointments}}" wx:key="id" class="appointment card">
      <view class="appointment-top">
        <view class="appointment-name">{{item.ayiName}} · {{item.role}}</view>
        <view class="status">{{item.status}}</view>
      </view>
      <view class="muted">联系人：{{item.name}} {{item.phone}}</view>
      <view class="muted">面试时间：{{item.date}}</view>
      <view class="muted">地址：{{item.address}}</view>
      <view class="created">提交时间：{{item.createdAt}}</view>
    </view>
  </view>

  <view wx:if="{{isAyi}}" class="section">
    <view class="section-title">我的接单</view>
    <view wx:if="{{noApplications}}" class="empty card">
      <view class="empty-title">还没有接单申请</view>
      <view class="muted">去服务页查看客户需求，选择合适的工作。</view>
      <button class="primary-button empty-button" bindtap="goHall">去找工作</button>
    </view>
    <view wx:for="{{applications}}" wx:key="id" class="appointment card">
      <view class="appointment-top">
        <view class="appointment-name">{{item.serviceType}}</view>
        <view class="status">{{item.status}}</view>
      </view>
      <view class="muted">地址：{{item.customerAddress}}</view>
      <view class="muted">上户时间：{{item.startTime}}</view>
      <view class="muted">预算：{{item.budget}}</view>
      <view class="note">家庭情况：{{item.familyInfo}}</view>
      <view class="created">申请时间：{{item.createdAt}}</view>
    </view>
  </view>
</view>
