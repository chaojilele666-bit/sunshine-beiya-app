<view class="page demand-detail-page">
  <view wx:if="{{loading}}" class="empty card">
    <view class="empty-title">正在读取需求</view>
    <view class="muted">请稍候</view>
  </view>

  <view wx:elif="{{error}}" class="empty card">
    <view class="empty-title">{{error}}</view>
    <button class="primary-button empty-button" bindtap="goBack">返回我的</button>
  </view>

  <block wx:else>
    <view class="summary card">
      <view class="summary-top">
        <view>
          <view class="eyebrow">需求编号 #{{demand.id}}</view>
          <view class="title">{{demand.serviceType}}</view>
        </view>
        <view class="status">{{demand.status}}</view>
      </view>
      <view class="muted">提交时间：{{demand.createdAt}}</view>
      <view class="muted">服务地址：{{demand.city}} {{demand.address}}</view>
      <view class="muted">上户时间：{{demand.startTime}}</view>
      <view class="muted">预算：{{demand.budget}}</view>
    </view>

    <view class="section card">
      <view class="section-title">处理进度</view>
      <view class="progress-list">
        <view class="progress-item active">待处理</view>
        <view class="progress-item {{demand.status === '已联系' || demand.status === '匹配中' || demand.status === '已匹配' ? 'active' : ''}}">已联系</view>
        <view class="progress-item {{demand.status === '匹配中' || demand.status === '已匹配' ? 'active' : ''}}">匹配中</view>
        <view class="progress-item {{demand.status === '已匹配' ? 'active' : ''}}">已匹配</view>
      </view>
      <view wx:if="{{demand.followNote}}" class="note">{{demand.followNote}}</view>
    </view>

    <view class="section">
      <view class="section-title">推荐阿姨</view>
      <view wx:if="{{noMatches}}" class="empty card">
        <view class="empty-title">顾问暂未推荐阿姨</view>
        <view class="muted">需求进入匹配后，会在这里看到推荐结果。</view>
      </view>

      <view wx:for="{{matches}}" wx:key="id" class="match-card card">
        <view class="match-top">
          <view class="avatar">{{item.ayi.avatarText}}</view>
          <view class="match-main" bindtap="goAyiDetail" data-id="{{item.ayi.id}}">
            <view class="name-row">
              <text class="name">{{item.ayi.name}}</text>
              <text class="role">{{item.ayi.serviceType}}</text>
            </view>
            <view class="muted">{{item.ayi.age || '-'}} 岁 · {{item.ayi.experience || 0}} 年经验 · {{item.ayi.hometown || '-'}}</view>
            <view class="price">{{item.ayi.salary || '面议'}}</view>
          </view>
          <view class="status">{{item.status}}</view>
        </view>
        <view wx:if="{{item.recommendNote}}" class="recommend-note">推荐说明：{{item.recommendNote}}</view>
        <view class="tag-list">
          <text wx:for="{{item.ayi.skills}}" wx:key="*this" class="tag">{{item}}</text>
        </view>
        <view class="actions" wx:if="{{item.status === '已推荐'}}">
          <button class="ghost-button" bindtap="rejectMatch" data-id="{{item.id}}">拒绝</button>
          <button class="primary-button" bindtap="confirmMatch" data-id="{{item.id}}">确认该阿姨</button>
        </view>
        <button wx:else class="ghost-button full" bindtap="goAyiDetail" data-id="{{item.ayi.id}}">查看阿姨详情</button>
      </view>
    </view>
  </block>
</view>
