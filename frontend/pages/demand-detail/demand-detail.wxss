.demand-detail-page {
  box-sizing: border-box;
  padding-bottom: 160rpx;
}

.summary,
.section,
.match-card {
  box-sizing: border-box;
}

.summary-top,
.match-top,
.name-row,
.actions {
  display: flex;
  align-items: center;
}

.summary-top,
.match-top {
  justify-content: space-between;
}

.eyebrow {
  margin-bottom: 8rpx;
  color: #8a949f;
  font-size: 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  color: #17212b;
}

.status {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #e3f5ee;
  color: #1f8a70;
  font-size: 24rpx;
  font-weight: 700;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.progress-list {
  display: flex;
  flex-wrap: wrap;
  margin-left: -8rpx;
  margin-top: -8rpx;
}

.progress-item {
  margin-left: 8rpx;
  margin-top: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 22rpx;
  background: #f2f4f6;
  color: #7a7f87;
  font-size: 24rpx;
}

.progress-item.active {
  background: #e3f5ee;
  color: #1f8a70;
  font-weight: 700;
}

.note,
.recommend-note {
  margin-top: 16rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1.6;
}

.avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 18rpx;
  border-radius: 44rpx;
  background: #f8e7d6;
  color: #1f8a70;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.match-main {
  flex: 1;
  min-width: 0;
}

.name {
  margin-right: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.role {
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  background: #fff0f4;
  color: #c45d7c;
  font-size: 22rpx;
}

.price {
  margin-top: 8rpx;
  color: #1f8a70;
  font-weight: 800;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-left: -8rpx;
  margin-top: 12rpx;
}

.tag {
  margin-left: 8rpx;
  margin-top: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 18rpx;
  background: #f2f4f6;
  color: #4b5563;
  font-size: 22rpx;
}

.actions {
  margin-top: 18rpx;
}

.actions button {
  flex: 1;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0;
  line-height: 76rpx;
  border-radius: 38rpx;
}

.actions button + button {
  margin-left: 16rpx;
}

.full {
  width: 100%;
  margin-top: 18rpx;
}
