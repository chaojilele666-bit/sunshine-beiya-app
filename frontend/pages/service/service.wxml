<view class="page service-page">
  <view wx:if="{{noRole}}" class="empty card">
    <view class="empty-title">请先选择身份</view>
    <view class="muted">客户看阿姨，阿姨看工作。</view>
    <button class="primary-button empty-button" bindtap="chooseRole">去选择身份</button>
  </view>

  <view wx:if="{{isCustomer}}">
    <view wx:if="{{backendError}}" class="empty card">
      <view class="empty-title">服务暂时不可用，请稍后重试</view>
      <view class="muted">后台数据读取失败，当前不展示本地样例数据。</view>
    </view>

    <view class="search-row">
      <view class="city">{{customerServiceCity}}</view>
      <view class="search-box">
        <text class="search-icon">⌕</text>
        <input placeholder="{{customerServiceTop.searchPlaceholder}}" value="{{query}}" bindinput="updateQuery" />
      </view>
    </view>
    <view wx:if="{{customerServiceTop.visible !== false && customerServiceTop.description}}" class="service-top-note card">
      {{customerServiceTop.description}}
    </view>

    <view class="feature-grid">
      <view
        wx:for="{{customerActions}}"
        wx:key="id"
        class="feature-card {{item.large ? 'large' : ''}}"
        bindtap="useFeature"
        data-item="{{item}}"
      >
        <image wx:if="{{item.displayIcon}}" class="feature-icon" src="{{item.displayIcon}}" mode="aspectFit" />
        <view class="feature-title">{{item.title}}</view>
        <view class="feature-desc">{{item.description || item.desc}}</view>
      </view>
    </view>

    <view class="type-scroll">
      <view class="type-row">
        <view
          wx:for="{{serviceTypes}}"
          wx:key="name"
          class="type-pill {{item.activeClass}}"
          bindtap="changeType"
          data-type="{{item.name}}"
        >
          {{item.name}}
        </view>
      </view>
    </view>

    <view class="filter-bar">
      <view wx:for="{{filterItems}}" wx:key="id" class="filter-item" bindtap="showFilter" data-name="{{item.title}}">{{item.title}}⌄</view>
    </view>

    <view wx:if="{{ayiListConfig.visible !== false}}">
      <view wx:for="{{visibleAyis}}" wx:key="id" class="ayi-card card" bindtap="goAyiDetail" data-id="{{item.id}}">
        <view class="avatar" style="background: {{item.avatarColor}};">{{item.avatarText}}</view>
        <view class="content">
          <view class="topline">
            <view class="ayi-title">
              <text class="name">{{item.name}}</text>
              <text class="role-tag">{{item.role}}</text>
            </view>
            <view wx:if="{{ayiListConfig.showRating}}" class="rating">{{item.rating}} 分</view>
          </view>
          <view wx:if="{{ayiListConfig.showAge || ayiListConfig.showExperience || ayiListConfig.showHometown}}" class="muted">
            <text wx:if="{{ayiListConfig.showAge}}">{{item.age}} 岁</text>
            <text wx:if="{{ayiListConfig.showAge && ayiListConfig.showExperience}}"> · </text>
            <text wx:if="{{ayiListConfig.showExperience}}">{{item.experience}} 年经验</text>
            <text wx:if="{{(ayiListConfig.showAge || ayiListConfig.showExperience) && ayiListConfig.showHometown}}"> · </text>
            <text wx:if="{{ayiListConfig.showHometown}}">{{item.hometown}}</text>
          </view>
          <view wx:if="{{ayiListConfig.showIntro}}" class="info">{{item.intro}}</view>
          <view class="bottom">
            <text wx:if="{{ayiListConfig.showSalary}}" class="price">￥{{item.salary}}</text>
            <text wx:if="{{ayiListConfig.showSchedule}}" class="muted">{{item.schedule}}</text>
          </view>
          <view class="card-actions">
            <button class="detail-button" catchtap="goAyiDetail" data-id="{{item.id}}">查看详情</button>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{noAyis || ayiListConfig.visible === false}}" class="empty card">
      <view class="empty-title">{{ayiListConfig.emptyTitle}}</view>
      <view class="muted">{{ayiListConfig.emptyDescription}}</view>
    </view>
  </view>

  <view wx:if="{{isAyi}}">
    <view wx:if="{{backendError}}" class="empty card">
      <view class="empty-title">服务暂时不可用，请稍后重试</view>
      <view class="muted">后台数据读取失败，当前不展示本地样例数据。</view>
    </view>

    <view wx:if="{{ayiJobTop.visible !== false}}" class="hero">
      <view class="eyebrow">{{ayiJobTop.eyebrow}}</view>
      <view class="title">{{ayiJobTop.title}}</view>
      <view class="muted">{{ayiJobTop.description}}</view>
      <view class="hero-actions">
        <button class="primary-button hero-button" bindtap="goProfile">{{ayiJobTop.profileButtonText}}</button>
        <button class="ghost-button hero-button" bindtap="goCerts">{{ayiJobTop.certButtonText}}</button>
      </view>
    </view>

    <view wx:if="{{ayiServiceTopActions.length}}" class="work-head">
      <view
        wx:for="{{ayiServiceTopActions}}"
        wx:key="id"
        class="work-tile"
        bindtap="useAyiTopAction"
        data-item="{{item}}"
      >
        <image wx:if="{{item.displayIcon}}" class="work-tile-icon" src="{{item.displayIcon}}" mode="aspectFit" />
        <view class="work-tile-title">{{item.title}}</view>
        <view wx:if="{{item.description}}" class="work-tile-desc">{{item.description}}</view>
      </view>
    </view>

    <view class="type-scroll">
      <view class="type-row">
        <view
          wx:for="{{serviceTypes}}"
          wx:key="name"
          class="type-pill {{item.activeClass}}"
          bindtap="changeType"
          data-type="{{item.name}}"
        >
          {{item.name}}
        </view>
      </view>
    </view>

    <view wx:if="{{ayiJobListConfig.visible !== false}}">
      <view wx:for="{{demands}}" wx:key="id" class="demand-card card">
        <view class="topline">
          <view wx:if="{{ayiJobListConfig.showServiceType}}" class="name">{{item.serviceType}}</view>
          <view wx:if="{{ayiJobListConfig.showBudget}}" class="price">{{item.budget}}</view>
        </view>
        <view class="job-info">
          <view wx:if="{{ayiJobListConfig.showAddress}}" class="job-row">
            <text class="job-label">地址</text>
            <text class="job-text">{{item.city}} {{item.address}}</text>
          </view>
          <view wx:if="{{ayiJobListConfig.showStartTime}}" class="job-row">
            <text class="job-label">上户时间</text>
            <text class="job-text">{{item.startTime}}</text>
          </view>
          <view wx:if="{{ayiJobListConfig.showStatus}}" class="job-row">
            <text class="job-label">状态</text>
            <text class="job-text">{{item.status}}</text>
          </view>
        </view>
        <view wx:if="{{ayiJobListConfig.showFamilyInfo}}" class="info">家庭情况：{{item.familyInfo}}</view>
        <view wx:if="{{ayiApplyConfig.visible !== false}}" class="demand-actions">
          <button
            class="{{item.buttonClass}} apply-button"
            disabled="{{item.disabled}}"
            bindtap="applyDemand"
            data-id="{{item.id}}"
          >
            {{item.buttonText}}
          </button>
        </view>
      </view>
    </view>

    <view wx:if="{{noDemands || ayiJobListConfig.visible === false}}" class="empty card">
      <view class="empty-title">{{ayiJobListConfig.emptyTitle}}</view>
      <view class="muted">{{ayiJobListConfig.emptyDescription}}</view>
    </view>
  </view>
</view>
