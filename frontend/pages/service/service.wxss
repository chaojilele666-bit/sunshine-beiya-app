.service-page {
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

.hero {
  padding: 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #e8f8f1 0%, #fff6e9 100%);
}

.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.city {
  flex: 0 0 auto;
  margin-right: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 74rpx;
  padding: 0 22rpx;
  border-radius: 38rpx;
  background: #ffffff;
  border: 1rpx solid #edf0f2;
}

.search-icon {
  margin-right: 12rpx;
  color: #9aa3ad;
  font-size: 34rpx;
}

.search-box input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
}

.service-top-note {
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  color: #5d6873;
  font-size: 26rpx;
  line-height: 1.5;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.feature-card {
  width: 48.6%;
  min-height: 120rpx;
  margin-right: 2.8%;
  margin-bottom: 14rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #fff4f7;
  box-sizing: border-box;
}

.feature-card:nth-child(2n) {
  margin-right: 0;
}

.feature-card.large {
  background: #e8f8f1;
}

.feature-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
}

.feature-title {
  color: #1f2933;
  font-size: 30rpx;
  font-weight: 800;
}

.feature-desc {
  margin-top: 10rpx;
  color: #77818c;
  font-size: 24rpx;
}

.eyebrow {
  color: #1f8a70;
  font-size: 26rpx;
  font-weight: 800;
}

.title {
  margin: 10rpx 0;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 800;
}

.hero-button {
  margin-top: 24rpx;
}

.hero-actions {
  display: flex;
  margin-top: 24rpx;
}

.hero-actions .hero-button {
  flex: 1;
  margin-top: 0;
  height: 76rpx;
  line-height: 76rpx;
}

.hero-actions .hero-button:first-child {
  margin-right: 16rpx;
}

.type-scroll {
  margin: 24rpx 0 16rpx;
}

.type-row {
  display: flex;
  flex-wrap: wrap;
}

.type-pill {
  min-width: 132rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
  padding: 0 18rpx;
  border-radius: 32rpx;
  background: #ffffff;
  color: #5d6873;
  text-align: center;
  font-size: 26rpx;
  box-sizing: border-box;
}

.type-pill.active {
  background: #1f8a70;
  color: #ffffff;
  font-weight: 800;
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  margin: 18rpx 0;
  padding: 8rpx 0;
}

.filter-item {
  width: 25%;
  color: #35424d;
  text-align: center;
  font-size: 28rpx;
  box-sizing: border-box;
}

.work-head {
  display: flex;
  margin-top: 16rpx;
  margin-bottom: 12rpx;
}

.work-tile {
  flex: 1;
  min-height: 116rpx;
  margin-right: 16rpx;
  padding: 16rpx 12rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #77818c;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.work-tile:last-child {
  margin-right: 0;
}

.work-tile-icon {
  display: block;
  width: 42rpx;
  height: 42rpx;
  margin: 0 auto 8rpx;
}

.work-tile-title {
  color: #1f2933;
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 800;
}

.work-tile-desc {
  margin-top: 6rpx;
  color: #8b949e;
  font-size: 22rpx;
  line-height: 1.3;
}

.ayi-card,
.demand-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.ayi-card {
  display: flex;
}

.avatar {
  flex: 0 0 128rpx;
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  margin-right: 22rpx;
  border-radius: 64rpx;
  color: #1f2933;
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
}

.content {
  min-width: 0;
  flex: 1;
}

.topline,
.bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.ayi-title {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.name {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.role-tag,
.status {
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
  background: #fff3df;
  color: #8b5d33;
  font-size: 22rpx;
}

.status {
  flex: 0 0 auto;
  background: #edf8f4;
  color: #1f8a70;
}

.rating,
.price {
  flex: 0 0 auto;
  color: #d45d3c;
  font-weight: 800;
}

.info {
  margin-top: 14rpx;
  color: #35424d;
  line-height: 1.5;
  word-break: break-all;
}

.job-info {
  margin-top: 14rpx;
}

.job-row {
  display: flex;
  align-items: flex-start;
  margin-top: 10rpx;
  line-height: 1.45;
}

.job-label {
  flex: 0 0 112rpx;
  color: #8b949e;
  font-size: 25rpx;
}

.job-text {
  flex: 1;
  min-width: 0;
  color: #35424d;
  font-size: 27rpx;
  word-break: break-all;
}

.card-actions {
  display: flex;
  margin-top: 18rpx;
}

.detail-button {
  width: 100%;
  height: 62rpx;
  line-height: 62rpx;
  margin: 0;
  padding: 0;
  border-radius: 31rpx;
  background: #edf8f4;
  color: #1f8a70;
  font-size: 26rpx;
  font-weight: 700;
}

.apply-button {
  width: 220rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0;
  padding: 0;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.demand-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.empty {
  padding: 40rpx 28rpx;
  text-align: center;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-button {
  margin-top: 28rpx;
}
