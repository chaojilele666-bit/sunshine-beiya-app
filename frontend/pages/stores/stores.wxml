<view class="page stores-page">
  <view class="search-row">
    <view class="city">{{city}}</view>
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input placeholder="搜索门店/小区/大厦名称" value="{{query}}" bindinput="updateQuery" />
    </view>
  </view>

  <view class="filter-panel">
    <view class="district-row">
      <view
        wx:for="{{districts}}"
        wx:key="name"
        class="district {{item.activeClass}}"
        bindtap="chooseDistrict"
        data-district="{{item.name}}"
      >
        {{item.name}}
      </view>
    </view>
    <view class="stay-check {{stayClass}}" bindtap="toggleStay">
      <view class="box">{{stayMark}}</view>
      <text>可住宿</text>
    </view>
  </view>

  <view wx:if="{{emptyText}}" class="empty card">
    <view class="empty-icon">⌛</view>
    <view class="empty-text">{{emptyText}}</view>
  </view>

  <view
    wx:for="{{visibleStores}}"
    wx:key="id"
    class="store-card card"
    bindtap="showStore"
    data-id="{{item.id}}"
  >
    <view class="store-header">
      <image
        wx:if="{{item.displayImage && !item.imageLoadFailed}}"
        class="store-image store-image-photo"
        src="{{item.displayImage}}"
        mode="aspectFill"
        binderror="handleStoreImageError"
        data-id="{{item.id}}"
        data-image-type="{{item.imageType}}"
        data-image-length="{{item.imageLength}}"
      />
      <view wx:else class="store-image store-image-placeholder" style="background: {{item.color}};">阳光</view>
      <view class="store-title">
        <view class="store-name" bindtap="showStore" data-id="{{item.id}}">{{item.name}}</view>
        <view class="store-district">{{item.district}}</view>
      </view>
      <view wx:if="{{item.canStay}}" class="stay-tag">可住宿</view>
    </view>

    <view class="store-main">
      <view class="store-line">
        <text class="line-label">地址</text>
        <text class="line-text">{{item.address}}</text>
      </view>
      <view class="store-line">
        <text class="line-label">覆盖</text>
        <text class="line-text">{{item.area}}</text>
      </view>
      <view class="tag-row">
        <text wx:for="{{item.tags}}" wx:key="*this" class="store-tag">{{item}}</text>
      </view>
    </view>
    <view class="store-actions">
      <button
        class="nav-button"
        catchtap="navigateStore"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        data-address="{{item.address}}"
        data-latitude="{{item.latitude}}"
        data-longitude="{{item.longitude}}"
      >导航</button>
      <button class="call-button" catchtap="callStore" data-phone="{{item.phone}}">电话</button>
    </view>
  </view>
</view>
