.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.city {
  flex: 0 0 auto;
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 800;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 74rpx;
  padding: 0 22rpx;
  border: 2rpx solid #f0b3c0;
  border-radius: 38rpx;
  background: #ffffff;
}

.city {
  margin-right: 18rpx;
}

.search-icon {
  margin-right: 12rpx;
  color: #c7ccd1;
  font-size: 34rpx;
}

.search-box input {
  flex: 1;
  height: 70rpx;
  min-width: 0;
}

.filter-panel {
  margin-bottom: 22rpx;
}

.district-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.district {
  min-width: 144rpx;
  height: 60rpx;
  line-height: 56rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 0 18rpx;
  border: 2rpx solid #edf0f2;
  border-radius: 30rpx;
  background: #ffffff;
  color: #7a7f87;
  text-align: center;
  font-size: 26rpx;
  box-sizing: border-box;
}

.district.active {
  border: 2rpx solid #f0b3c0;
  background: #fff4f7;
  color: #d95e7a;
  font-weight: 800;
}

.stay-check {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border: 2rpx solid #edf0f2;
  border-radius: 30rpx;
  background: #ffffff;
  color: #77818c;
  font-size: 26rpx;
  box-sizing: border-box;
}

.box {
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  margin-right: 10rpx;
  border: 2rpx solid #d8dde3;
  border-radius: 8rpx;
  color: #1f8a70;
  text-align: center;
  font-size: 24rpx;
}

.stay-check.checked {
  border-color: #f0b3c0;
  background: #fff4f7;
  color: #1f8a70;
  font-weight: 800;
}

.store-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.store-header {
  display: flex;
  align-items: flex-start;
}

.store-image {
  flex: 0 0 140rpx;
  width: 140rpx;
  height: 110rpx;
  line-height: 110rpx;
  margin-right: 20rpx;
  border-radius: 10rpx;
  color: #1f8a70;
  text-align: center;
  font-weight: 800;
}

.store-title {
  min-width: 0;
  flex: 1;
}

.store-name {
  margin-bottom: 8rpx;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 800;
  word-break: break-all;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.store-district {
  color: #77818c;
  font-size: 24rpx;
}

.stay-tag {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: #edf8f4;
  color: #1f8a70;
  font-size: 22rpx;
  font-weight: 700;
}

.store-main {
  margin-top: 18rpx;
}

.store-line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
  line-height: 38rpx;
}

.line-label {
  flex: 0 0 70rpx;
  color: #9aa3ad;
  font-size: 24rpx;
}

.line-text {
  min-width: 0;
  flex: 1;
  color: #68727d;
  font-size: 26rpx;
  word-break: break-all;
}

.tag-row {
  margin-top: 12rpx;
}

.store-tag {
  display: inline-block;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 22rpx;
  background: #fff4f7;
  color: #d95e7a;
  font-size: 24rpx;
}

.store-actions {
  display: flex;
  margin-top: 18rpx;
}

.nav-button,
.call-button {
  flex: 1;
  height: 66rpx;
  line-height: 66rpx;
  margin: 0;
  padding: 0;
  border-radius: 34rpx;
  background: #edf8f4;
  color: #1f8a70;
  font-size: 26rpx;
  font-weight: 700;
}

.nav-button {
  margin-right: 16rpx;
}

.call-button {
  background: #fff4f7;
  color: #d95e7a;
}

.empty {
  padding: 80rpx 30rpx;
  text-align: center;
}

.empty-icon {
  margin-bottom: 20rpx;
  color: #9aa3ad;
  font-size: 64rpx;
}

.empty-text {
  color: #5d6873;
  font-size: 30rpx;
}
