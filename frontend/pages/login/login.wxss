.login-page {
  min-height: 100vh;
  padding: 64rpx 32rpx;
  background: #f4f6f7;
  box-sizing: border-box;
}

.login-card {
  padding: 40rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e7ecef;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #17233d;
  line-height: 1.35;
}

.login-desc {
  margin-top: 16rpx;
  margin-bottom: 40rpx;
  font-size: 28rpx;
  color: #697386;
  line-height: 1.6;
}

.login-button {
  width: 100%;
  height: 92rpx;
  margin: 0 0 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.login-button.primary {
  color: #ffffff;
  background: #1f8a70;
}

.login-button.secondary {
  color: #1f8a70;
  background: #eef8f4;
}

.guest-button {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  margin: 4rpx 0 0;
  padding: 0;
  color: #52616f;
  background: transparent;
  font-size: 28rpx;
}

.guest-button::after {
  border: 0;
}

.login-message {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #b42318;
  line-height: 1.5;
}
