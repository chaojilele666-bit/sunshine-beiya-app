<view class="messages-page">
  <view wx:if="{{needLogin}}" class="login-required-card">
    <view class="empty-title">消息需要登录后查看</view>
    <view class="empty-desc">登录后可以查看需求、面试、审核和接单提醒。</view>
    <button class="login-action primary" bindtap="goLogin">去登录</button>
    <button class="login-action" bindtap="goHome">返回首页</button>
  </view>

  <block wx:else>
    <view class="messages-header">
      <view>
        <view class="messages-title">消息中心</view>
        <view class="messages-subtitle">查看业务提醒、面试安排和审核结果</view>
      </view>
      <button class="read-all-button" bindtap="markAllRead">全部已读</button>
    </view>

    <scroll-view class="category-scroll" scroll-x="true">
      <view class="category-list">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="category-pill {{activeCategory === item.key ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="switchCategory"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{loading}}" class="empty-card">正在加载消息...</view>

    <view wx:elif="{{empty}}" class="empty-card">
      <view class="empty-title">暂无消息</view>
      <view class="empty-desc">新的需求、面试和审核提醒会显示在这里。</view>
    </view>

    <view wx:else class="message-list">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        class="message-card {{item.isRead ? '' : 'is-unread'}}"
        data-id="{{item.id}}"
        bindtap="openMessage"
      >
        <view class="message-main">
          <view class="message-top">
            <text class="message-title">{{item.title}}</text>
            <text wx:if="{{!item.isRead}}" class="unread-dot"></text>
          </view>
          <view class="message-summary">{{item.summary}}</view>
          <view class="message-meta">{{item.typeLabel}} · {{item.timeText}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
