.role-page {
  padding-top: 20rpx;
  padding-bottom: 40rpx;
}

.brand-card {
  display: flex;
  align-items: center;
  padding: 26rpx;
  margin: 22rpx 0;
}

.logo {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  margin-right: 22rpx;
  border-radius: 52rpx;
  background: #1f8a70;
  color: #ffffff;
  text-align: center;
  font-weight: 800;
}

.brand-copy {
  flex: 1;
  min-width: 0;
}

.brand-name {
  margin-bottom: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.brand-desc,
.role-note {
  color: #5d6873;
  line-height: 1.5;
}

.role-heading {
  color: #1f2933;
  font-size: 42rpx;
  font-weight: 900;
}

.role-subtitle {
  margin-top: 8rpx;
  color: #77818c;
  font-size: 26rpx;
}

.role-card {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 26rpx;
}

.role-main {
  flex: 1;
  min-width: 0;
  margin-right: 18rpx;
}

.role-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 900;
}

.role-desc {
  margin-top: 8rpx;
  color: #5d6873;
  font-size: 25rpx;
  line-height: 1.45;
}

.role-button {
  flex: 0 0 176rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 34rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
}

.role-button.customer {
  background: #1f8a70;
}

.role-button.ayi {
  background: #315b7c;
}

.identity-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 18rpx 22rpx;
  color: #35424d;
  font-weight: 700;
}

.identity-switch {
  color: #1f8a70;
}

.company-showcase {
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.company-showcase-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.company-showcase-heading {
  color: #1f2933;
  font-size: 34rpx;
  font-weight: 700;
}

.company-showcase-more {
  color: #1f8a70;
  font-size: 26rpx;
  font-weight: 500;
}

.company-showcase-swiper {
  width: 100%;
  height: 350rpx;
  border: 1rpx solid #e7eaee;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(31, 41, 51, 0.06);
  overflow: hidden;
}

.company-showcase-slide {
  position: relative;
  width: 100%;
  height: 350rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #f8fafb;
}

.company-showcase-image {
  width: 100%;
  height: 350rpx;
  display: block;
}

.company-showcase-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 22rpx;
  background: rgba(31, 41, 51, 0.5);
  color: #ffffff;
}

.company-showcase-title {
  display: block;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.company-showcase-subtitle {
  display: block;
  overflow: hidden;
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 1.35;
  opacity: 0.9;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.priority-section {
  margin-top: 26rpx;
}

.ayi-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 18rpx;
  padding: 10rpx 4rpx;
}

.ayi-page-title {
  color: #1f2933;
  font-size: 44rpx;
  font-weight: 900;
}

.ayi-action-strip {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #f4d5de;
  background: #fff7fa;
  overflow: hidden;
}

.verify-copy {
  width: 100%;
}

.verify-title {
  margin-bottom: 4rpx;
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 800;
}

.mini-button {
  width: 100%;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 32rpx;
  background: #ec6f8f;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.strip-buttons {
  display: flex;
  gap: 10rpx;
}

.strip-buttons .mini-button {
  flex: 1;
}

.mini-button.outline {
  background: #ffffff;
  color: #ec6f8f;
  border: 1rpx solid #f0abc0;
}

.ayi-mini-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin: 18rpx 0 8rpx;
}

.mini-tab {
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #7a7f87;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
}

.mini-tab.active {
  background: #fff0f5;
  color: #ec6f8f;
}

.switch-button {
  margin: 0;
}

.switch-button {
  flex: 0 0 170rpx;
  align-self: flex-start;
}

.customer-quick-section {
  margin-top: 20rpx;
}

.customer-quick-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.customer-quick-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 800;
}

.customer-quick-subtitle {
  color: #77818c;
  font-size: 24rpx;
  font-weight: 600;
}

.customer-quick-grid {
  display: flex;
  flex-wrap: wrap;
}

.ayi-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tool {
  width: 48%;
  margin-right: 2%;
  margin-bottom: 14rpx;
  padding: 22rpx 16rpx;
  text-align: center;
}

.customer-quick-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 48.5%;
  height: 164rpx;
  margin-right: 3%;
  margin-bottom: 16rpx;
  padding: 20rpx 14rpx;
  border: 1rpx solid #e7ecef;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: none;
  text-align: left;
}

.customer-quick-card:nth-child(2n),
.ayi-grid .tool:nth-child(2n) {
  margin-right: 0;
}

.customer-quick-card--pressed {
  opacity: 0.74;
}

.customer-quick-icon {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin-right: 14rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.customer-quick-icon--ayi {
  background: #e4f6ef;
}

.customer-quick-icon--demand {
  background: #fff0f5;
  color: #d85778;
}

.customer-quick-icon--service {
  background: #edf4ff;
  color: #315b7c;
}

.customer-quick-icon--about {
  background: #fff4df;
  color: #9a6a22;
}

.customer-quick-icon-image {
  display: block;
  width: 44rpx;
  height: 44rpx;
  margin: 14rpx;
}

.customer-quick-copy {
  flex: 1;
  min-width: 0;
}

.customer-quick-card-title,
.tool-title {
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 800;
}

.customer-quick-desc {
  overflow: hidden;
  margin-top: 6rpx;
  color: #77818c;
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-quick-action {
  margin-top: 10rpx;
  color: #1f8a70;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.customer-quick-arrow {
  flex: 0 0 20rpx;
  margin-left: 8rpx;
  color: #9aa1a9;
  font-size: 34rpx;
  line-height: 1;
}

.customer-service-section {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 26rpx 18rpx 22rpx;
  border: 1rpx solid #edf0f2;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 51, 0.04);
}

.customer-service-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.customer-service-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 800;
}

.customer-service-more {
  color: #1f8a70;
  font-size: 25rpx;
  font-weight: 600;
}

.service-highlight-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.service-highlight-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 14rpx;
  padding: 16rpx;
  border: 1rpx solid #edf2f0;
  border-radius: 18rpx;
  background: #f7faf9;
}

.service-highlight-icon {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  margin-right: 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.service-highlight-image {
  display: block;
  width: 52rpx;
  height: 52rpx;
  margin: 12rpx;
}

.service-highlight-copy {
  flex: 1;
  min-width: 0;
}

.service-highlight-title {
  display: block;
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.service-highlight-desc {
  display: block;
  margin-top: 4rpx;
  color: #77818c;
  font-size: 23rpx;
  line-height: 1.35;
}

.service-icon-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.service-card-item {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 48.5%;
  min-height: 142rpx;
  margin-right: 3%;
  margin-bottom: 14rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid #e7ecef;
  border-radius: 20rpx;
  background: #ffffff;
}

.service-card-item:nth-child(2n) {
  margin-right: 0;
}

.service-highlight-card--pressed,
.service-card-item--pressed {
  opacity: 0.72;
}

.service-card-icon {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  margin-right: 12rpx;
  border-radius: 22rpx;
  background: #e8f8f1;
  box-shadow: inset 0 0 0 1rpx rgba(31, 138, 112, 0.08);
  overflow: hidden;
}

.service-card-image {
  display: block;
  width: 56rpx;
  height: 56rpx;
  margin: 16rpx;
}

.service-card-copy {
  flex: 1;
  min-width: 0;
}

.service-card-title {
  display: block;
  color: #1f2933;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.25;
}

.service-card-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: #77818c;
  font-size: 21rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.service-card-arrow {
  flex: 0 0 20rpx;
  margin-left: 6rpx;
  color: #9aa1a9;
  font-size: 30rpx;
  line-height: 1;
}

.service-icon-sticker--green {
  background: #dff4ec;
}

.service-icon-sticker--mint {
  background: #e7f7ef;
}

.service-icon-sticker--pink {
  background: #fff0f5;
}

.service-icon-sticker--blue {
  background: #edf4ff;
}

.service-icon-sticker--gold {
  background: #fff4df;
}

.service-icon-sticker--default {
  background: #eef5f2;
}

.process {
  padding: 24rpx;
}

.process-item {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.process-item:last-child {
  border-bottom: 0;
}

.process-no {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 24rpx;
  background: #1f8a70;
  color: #ffffff;
  text-align: center;
  font-weight: 800;
}

.process-title {
  margin-bottom: 6rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.more {
  color: #1f8a70;
  font-size: 26rpx;
  font-weight: 500;
}

.ayi-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.job-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
}

.job-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.job-title {
  font-size: 36rpx;
  font-weight: 800;
}

.job-budget {
  flex: 0 0 auto;
  color: #d45d3c;
  font-weight: 800;
}

.job-line {
  margin-top: 10rpx;
  color: #35424d;
  line-height: 1.5;
}

.job-meta {
  display: grid;
  grid-template-columns: 140rpx 1fr;
  gap: 16rpx;
  margin-top: 14rpx;
  line-height: 1.45;
}

.job-meta text:first-child {
  color: #9aa1a9;
}

.job-meta text:last-child {
  color: #1f2933;
  font-weight: 700;
}

.job-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
}

.update-time {
  color: #9aa1a9;
  font-size: 24rpx;
}

.apply-mini {
  width: 168rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 32rpx;
  border: 1rpx solid #e8e8e8;
  background: #ffffff;
  color: #4d535a;
  font-size: 26rpx;
  font-weight: 700;
}

.compact-grid {
  margin-top: 10rpx;
}

.top-tools {
  margin-top: 0;
  margin-bottom: 18rpx;
}

.ayi-avatar {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 132rpx;
  line-height: 132rpx;
  border-radius: 66rpx;
  color: #1f2933;
  text-align: center;
  font-size: 42rpx;
  font-weight: 800;
}

.ayi-info {
  min-width: 0;
  flex: 1;
}

.ayi-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.ayi-name {
  font-size: 32rpx;
  font-weight: 700;
}

.ayi-role {
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
  background: #fff3df;
  color: #8b5d33;
  font-size: 22rpx;
}

.tag-line {
  margin-top: 14rpx;
}

.ayi-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  gap: 12rpx;
}

.price {
  color: #d45d3c;
  font-weight: 800;
}
