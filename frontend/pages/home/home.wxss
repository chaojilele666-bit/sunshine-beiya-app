.role-page {
  padding-top: 48rpx;
}

.brand-card {
  padding: 40rpx 28rpx;
  margin-bottom: 34rpx;
  text-align: center;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 22rpx;
  border-radius: 60rpx;
  background: #1f8a70;
  color: #ffffff;
  font-weight: 800;
}

.brand-name {
  margin-bottom: 12rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.brand-desc,
.role-note {
  color: #5d6873;
  line-height: 1.5;
  text-align: center;
}

.role-button {
  height: 108rpx;
  line-height: 108rpx;
  margin-top: 28rpx;
  border-radius: 54rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
}

.role-button.customer {
  background: #1f8a70;
}

.role-button.ayi {
  background: #315b7c;
}

.identity-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  color: #35424d;
  font-weight: 700;
}

.identity-switch {
  color: #1f8a70;
}

.priority-section {
  margin-top: 26rpx;
}

.hero,
.ayi-hero {
  padding: 34rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #e8f8f1 0%, #fff6e9 100%);
}

.hero-top,
.ayi-hero {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.city {
  display: inline-block;
  margin-bottom: 14rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #1f8a70;
  font-size: 24rpx;
}

.customer-title,
.eyebrow {
  margin-bottom: 12rpx;
  color: #1f8a70;
  font-size: 30rpx;
  font-weight: 800;
}

.hero-title,
.title {
  max-width: 520rpx;
  font-size: 44rpx;
  line-height: 1.22;
  font-weight: 800;
}

.hero-mark {
  flex: 0 0 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  border-radius: 56rpx;
  background: #1f8a70;
  color: #ffffff;
  text-align: center;
  font-weight: 700;
}

.hero-copy {
  margin-top: 20rpx;
  color: #5d6873;
}

.hero-actions {
  display: grid;
  grid-template-columns: 1fr 180rpx;
  gap: 16rpx;
  margin-top: 28rpx;
}

.ayi-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 18rpx;
  padding: 10rpx 4rpx;
}

.ayi-page-title {
  color: #1f2933;
  font-size: 44rpx;
  font-weight: 900;
}

.ayi-action-strip {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #f4d5de;
  background: #fff7fa;
  overflow: hidden;
}

.verify-copy {
  width: 100%;
}

.verify-title {
  margin-bottom: 4rpx;
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 800;
}

.mini-button {
  width: 100%;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 32rpx;
  background: #ec6f8f;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.strip-buttons {
  display: flex;
  gap: 10rpx;
}

.strip-buttons .mini-button {
  flex: 1;
}

.mini-button.outline {
  background: #ffffff;
  color: #ec6f8f;
  border: 1rpx solid #f0abc0;
}

.ayi-mini-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin: 18rpx 0 8rpx;
}

.mini-tab {
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #7a7f87;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
}

.mini-tab.active {
  background: #fff0f5;
  color: #ec6f8f;
}

.hero-button,
.switch-button {
  margin: 0;
}

.switch-button {
  flex: 0 0 170rpx;
  align-self: flex-start;
}

.quick-grid,
.ayi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.quick-grid {
  grid-template-columns: repeat(3, 1fr);
}

.quick-item,
.tool {
  padding: 22rpx 16rpx;
  text-align: center;
}

.quick-title,
.tool-title {
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 800;
}

.quick-desc {
  margin-top: 8rpx;
  color: #77818c;
  font-size: 22rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat-card {
  padding: 22rpx 12rpx;
  text-align: center;
}

.stat-value {
  margin-bottom: 8rpx;
  color: #1f2933;
  font-size: 25rpx;
  font-weight: 800;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.service-card {
  width: calc((100% - 18rpx) / 2);
  padding: 26rpx;
}

.service-name {
  font-size: 32rpx;
  font-weight: 700;
}

.service-desc {
  margin-top: 10rpx;
  color: #77818c;
  font-size: 24rpx;
}

.process {
  padding: 24rpx;
}

.process-item {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.process-item:last-child {
  border-bottom: 0;
}

.process-no {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 24rpx;
  background: #1f8a70;
  color: #ffffff;
  text-align: center;
  font-weight: 800;
}

.process-title {
  margin-bottom: 6rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.more {
  color: #1f8a70;
  font-size: 26rpx;
  font-weight: 500;
}

.ayi-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.job-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
}

.job-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.job-title {
  font-size: 36rpx;
  font-weight: 800;
}

.job-budget {
  flex: 0 0 auto;
  color: #d45d3c;
  font-weight: 800;
}

.job-line {
  margin-top: 10rpx;
  color: #35424d;
  line-height: 1.5;
}

.job-meta {
  display: grid;
  grid-template-columns: 140rpx 1fr;
  gap: 16rpx;
  margin-top: 14rpx;
  line-height: 1.45;
}

.job-meta text:first-child {
  color: #9aa1a9;
}

.job-meta text:last-child {
  color: #1f2933;
  font-weight: 700;
}

.job-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
}

.update-time {
  color: #9aa1a9;
  font-size: 24rpx;
}

.apply-mini {
  width: 168rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 32rpx;
  border: 1rpx solid #e8e8e8;
  background: #ffffff;
  color: #4d535a;
  font-size: 26rpx;
  font-weight: 700;
}

.compact-grid {
  margin-top: 10rpx;
}

.top-tools {
  margin-top: 0;
  margin-bottom: 18rpx;
}

.ayi-avatar {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 132rpx;
  line-height: 132rpx;
  border-radius: 66rpx;
  color: #1f2933;
  text-align: center;
  font-size: 42rpx;
  font-weight: 800;
}

.ayi-info {
  min-width: 0;
  flex: 1;
}

.ayi-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.ayi-name {
  font-size: 32rpx;
  font-weight: 700;
}

.ayi-role {
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
  background: #fff3df;
  color: #8b5d33;
  font-size: 22rpx;
}

.tag-line {
  margin-top: 14rpx;
}

.ayi-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  gap: 12rpx;
}

.price {
  color: #d45d3c;
  font-weight: 800;
}
