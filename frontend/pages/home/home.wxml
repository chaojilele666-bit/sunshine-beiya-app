<view class="page">
  <view wx:if="{{noRole}}" class="role-page">
    <view class="role-heading">选择身份</view>
    <view class="role-subtitle">根据你的身份进入对应功能。</view>

    <view class="brand-card card">
      <view class="logo">阳光</view>
      <view class="brand-copy">
        <view class="brand-name">北京阳光北亚家政</view>
        <view class="brand-desc">家政、母婴、养老护理，一站式匹配服务。</view>
      </view>
    </view>

    <view class="role-card card">
      <view class="role-main">
        <view class="role-title">客户入口</view>
        <view class="role-desc">发布需求、找阿姨、预约面试、查看服务进度。</view>
      </view>
      <button class="role-button customer" bindtap="chooseCustomer">我是客户</button>
    </view>

    <view class="role-card card">
      <view class="role-main">
        <view class="role-title">阿姨入口</view>
        <view class="role-desc">完善资料、上传证件健康证、查看需求、申请接单。</view>
      </view>
      <button class="role-button ayi" bindtap="chooseAyi">我是阿姨</button>
    </view>
  </view>

  <view wx:if="{{isCustomer}}" class="customer-page">
    <view class="identity-bar card">
      <text>当前身份：客户</text>
      <text class="identity-switch" bindtap="switchRole">切换身份</text>
    </view>

    <view wx:if="{{customerHero.visible !== false}}" class="customer-home-hero">
      <view class="customer-home-hero-copy">
        <view class="customer-home-hero-meta">
          <image
            wx:if="{{companyLogoDisplay}}"
            class="customer-home-logo"
            src="{{companyLogoDisplay}}"
            mode="aspectFit"
          />
          <text class="customer-home-city">{{companyDefaultCity}}</text>
          <text class="customer-home-name">{{companyDisplayName}}</text>
        </view>
        <view class="customer-home-title">{{customerHero.title}}</view>
        <view class="customer-home-subtitle">{{customerHero.subtitle}}</view>
      </view>
      <view class="customer-home-actions">
        <button
          class="customer-home-action primary"
          bindtap="handleCustomerHeroTap"
          data-target-type="{{customerHero.primaryTargetType}}"
          data-target-value="{{customerHero.primaryTargetValue}}"
        >
          {{customerHero.primaryText}}
        </button>
        <button
          class="customer-home-action secondary"
          bindtap="handleCustomerHeroTap"
          data-target-type="{{customerHero.secondaryTargetType}}"
          data-target-value="{{customerHero.secondaryTargetValue}}"
        >
          {{customerHero.secondaryText}}
        </button>
      </view>
    </view>

    <view wx:if="{{isCustomer && companyBanners.length > 0}}" class="company-showcase">
      <view class="company-showcase-header">
        <text class="company-showcase-heading">公司展示</text>
        <text class="company-showcase-more" bindtap="goAbout">查看更多 ›</text>
      </view>
      <swiper
        class="company-showcase-swiper"
        indicator-dots="{{true}}"
        autoplay="{{true}}"
        circular="{{true}}"
        interval="4000"
        duration="500"
      >
        <swiper-item wx:for="{{companyBanners}}" wx:key="id" data-index="{{index}}" bindtap="handleCompanyBannerTap">
          <view class="company-showcase-slide">
            <image
              class="company-showcase-image"
              src="{{item.displayImage}}"
              mode="{{item.imageMode}}"
              binderror="handleCompanyBannerImageError"
              data-id="{{item.id}}"
            />
            <view wx:if="{{item.title || item.subtitle}}" class="company-showcase-caption">
              <text wx:if="{{item.title}}" class="company-showcase-title">{{item.title}}</text>
              <text wx:if="{{item.subtitle}}" class="company-showcase-subtitle">{{item.subtitle}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view wx:if="{{customerShortcuts.length}}" class="customer-quick-section">
      <view class="customer-quick-header">
        <text class="customer-quick-title">快捷服务</text>
        <text class="customer-quick-subtitle">常用入口</text>
      </view>
      <view class="customer-quick-grid">
        <view
          wx:for="{{customerShortcuts}}"
          wx:key="id"
          class="customer-quick-card card"
          bindtap="handleShortcutTap"
          data-item="{{item}}"
          hover-class="customer-quick-card--pressed"
        >
          <view class="customer-quick-icon service-icon-sticker--{{item.theme}}">
            <image
              class="customer-quick-icon-image"
              src="{{item.displayIcon}}"
              mode="aspectFit"
              data-id="{{item.id}}"
              binderror="handleServiceIconError"
            />
          </view>
          <view class="customer-quick-copy">
            <view class="customer-quick-card-title">{{item.title}}</view>
            <view class="customer-quick-desc">{{item.description}}</view>
            <view class="customer-quick-action">立即进入</view>
          </view>
          <view class="customer-quick-arrow">›</view>
        </view>
      </view>
    </view>

    <view wx:if="{{serviceHighlights.length || serviceItems.length}}" class="customer-service-section">
      <view class="customer-service-header">
        <text class="customer-service-title">服务中心</text>
        <text class="customer-service-more" bindtap="goList">查看全部 ›</text>
      </view>

      <view wx:if="{{serviceHighlights.length}}" class="service-highlight-grid">
        <view
          wx:for="{{serviceHighlights}}"
          wx:key="id"
          class="service-highlight-card"
          data-item="{{item}}"
          bindtap="handleServiceCenterTap"
          hover-class="service-highlight-card--pressed"
        >
          <view class="service-highlight-icon service-icon-sticker--{{item.theme}}">
            <image
              class="service-highlight-image"
              src="{{item.displayIcon}}"
              mode="aspectFit"
              data-id="{{item.id}}"
              binderror="handleServiceIconError"
            />
          </view>
          <view class="service-highlight-copy">
            <text class="service-highlight-title">{{item.title}}</text>
            <text class="service-highlight-desc">{{item.description}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{serviceItems.length}}" class="service-icon-grid">
        <view
          wx:for="{{serviceItems}}"
          wx:key="id"
          class="service-card-item"
          bindtap="handleServiceCenterTap"
          data-item="{{item}}"
          hover-class="service-card-item--pressed"
        >
          <view class="service-card-icon service-icon-sticker--{{item.theme}}">
            <image
              class="service-card-image"
              src="{{item.displayIcon}}"
              mode="aspectFit"
              data-id="{{item.id}}"
              binderror="handleServiceIconError"
            />
          </view>
          <view class="service-card-copy">
            <text class="service-card-title">{{item.title}}</text>
            <text class="service-card-desc">{{item.description}}</text>
          </view>
          <text class="service-card-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">
        <text>今日推荐阿姨</text>
        <text class="more" bindtap="goList">查看更多</text>
      </view>
      <view wx:for="{{recommended}}" wx:key="id" class="ayi-card card" bindtap="goDetail" data-id="{{item.id}}">
        <view class="ayi-avatar" style="background: {{item.avatarColor}};">{{item.avatarText}}</view>
        <view class="ayi-info">
          <view class="ayi-head">
            <text class="ayi-name">{{item.name}}</text>
            <text class="ayi-role">{{item.role}}</text>
          </view>
          <view class="muted">{{item.experience}} 年经验 · {{item.hometown}}</view>
          <view class="tag-line">
            <text wx:for="{{item.skills}}" wx:key="*this" class="tag">{{item}}</text>
          </view>
          <view class="ayi-bottom">
            <text class="price">¥{{item.salary}}</text>
            <text class="muted">{{item.schedule}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">服务流程</view>
      <view class="process card">
        <view wx:for="{{process}}" wx:key="step" class="process-item">
          <view class="process-no">{{item.step}}</view>
          <view>
            <view class="process-title">{{item.title}}</view>
            <view class="muted">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{isAyi}}" class="ayi-page">
    <view class="ayi-topbar">
      <view wx:if="{{ayiTop.visible !== false}}">
        <view class="ayi-brand-line">
          <image
            wx:if="{{companyLogoDisplay}}"
            class="ayi-brand-logo"
            src="{{companyLogoDisplay}}"
            mode="aspectFit"
          />
          <text class="ayi-brand-name">{{companyDisplayName}}</text>
        </view>
        <view class="ayi-page-title">{{ayiTop.title}}</view>
        <view class="muted">{{companyDefaultCity}} · {{ayiTop.description}}</view>
      </view>
      <text class="identity-switch" bindtap="switchRole">切换身份</text>
    </view>

    <view class="ayi-grid compact-grid top-tools">
      <view
        wx:for="{{ayiQuickEntries}}"
        wx:key="id"
        class="tool card"
        bindtap="handleAyiShortcutTap"
        data-item="{{item}}"
      >
        <view class="tool-title">{{item.title}}</view>
        <view class="muted">{{item.description}}</view>
      </view>
    </view>

    <view wx:if="{{ayiProfilePrompt.visible !== false}}" class="ayi-action-strip card">
      <view class="verify-copy">
        <view class="verify-title">{{ayiProfilePrompt.title}}</view>
        <view class="muted">{{ayiProfilePrompt.description || profileText}}</view>
      </view>
      <view class="strip-buttons">
        <button class="mini-button" bindtap="goProfile">{{ayiProfilePrompt.profileButtonText}}</button>
        <button class="mini-button outline" bindtap="goCerts">{{ayiProfilePrompt.certButtonText}}</button>
      </view>
    </view>

    <view class="ayi-mini-tabs">
      <view
        wx:for="{{ayiNavItems}}"
        wx:key="id"
        class="mini-tab {{index === 0 ? 'active' : ''}}"
        bindtap="handleAyiNavTap"
        data-item="{{item}}"
      >
        {{item.title}}
      </view>
    </view>

    <view wx:if="{{ayiRecommendedJobs.visible !== false}}" class="section priority-section">
      <view class="section-title">
        <text>{{ayiRecommendedJobs.title}}</text>
        <text class="more" bindtap="goHall">{{ayiRecommendedJobs.moreText}}</text>
      </view>
      <view wx:for="{{todayJobs}}" wx:key="id" class="job-card card" bindtap="goHall" data-type="{{item.serviceType}}">
        <view class="job-top">
          <view>
            <view class="job-title">{{item.serviceType}}</view>
            <view class="muted">订单号：YG{{item.id}}</view>
          </view>
          <view class="job-budget">{{item.budget}}</view>
        </view>
        <view class="job-meta">
          <text>服务地址</text>
          <text>{{item.city}} {{item.address}}</text>
        </view>
        <view class="job-meta">
          <text>上户时间</text>
          <text>{{item.startTime}}</text>
        </view>
        <view class="job-line">用人要求：{{item.familyInfo}}</view>
        <view class="job-card-footer">
          <text class="update-time">刚刚更新</text>
          <button class="apply-mini" catchtap="goHall" data-type="{{item.serviceType}}">看一看</button>
        </view>
      </view>
    </view>

  </view>
</view>
