.empty {
  padding: 40rpx 28rpx;
  text-align: center;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-button {
  margin-top: 28rpx;
}

.application {
  margin-bottom: 18rpx;
  padding: 26rpx;
}

.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.service {
  font-size: 34rpx;
  font-weight: 800;
}

.status {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 18rpx;
  background: #edf8f4;
  color: #1f8a70;
  font-size: 22rpx;
}

.info {
  margin-top: 12rpx;
  color: #35424d;
  line-height: 1.55;
}

.created {
  margin-top: 16rpx;
  color: #a0a8b1;
  font-size: 24rpx;
}
