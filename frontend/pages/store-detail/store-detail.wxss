.store-detail-page {
  padding-bottom: 160rpx;
}

.hero-card,
.section-card {
  margin-bottom: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.hero-card {
  padding-bottom: 26rpx;
}

.store-hero-image,
.store-hero-placeholder {
  display: block;
  width: 100%;
  height: 300rpx;
}

.store-hero-placeholder {
  line-height: 300rpx;
  background: linear-gradient(135deg, #d9f1e9 0%, #fff4f7 100%);
  color: #1f8a70;
  text-align: center;
  font-size: 56rpx;
  font-weight: 900;
}

.hero-content {
  padding: 26rpx;
}

.store-title-row {
  display: flex;
  align-items: flex-start;
}

.store-title {
  flex: 1;
  min-width: 0;
  color: #1f2933;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 900;
  word-break: break-all;
}

.store-district {
  margin-top: 10rpx;
  color: #77818c;
  font-size: 26rpx;
}

.stay-tag,
.featured-tag {
  flex: 0 0 auto;
  margin-left: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 22rpx;
  background: #edf8f4;
  color: #1f8a70;
  font-size: 22rpx;
  font-weight: 800;
}

.tag-row {
  margin-top: 16rpx;
}

.store-tag,
.skill-tag {
  display: inline-block;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 22rpx;
  background: #fff4f7;
  color: #d95e7a;
  font-size: 24rpx;
}

.business-hours {
  margin-top: 8rpx;
  color: #5d6873;
  font-size: 26rpx;
}

.section-card {
  padding: 26rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #1f2933;
  font-size: 34rpx;
  font-weight: 900;
}

.paragraph {
  color: #35424d;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-all;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
  line-height: 1.55;
}

.info-label {
  flex: 0 0 132rpx;
  color: #9aa3ad;
  font-size: 25rpx;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #35424d;
  font-size: 27rpx;
  word-break: break-all;
}

.manager-card,
.ayi-card {
  display: flex;
  align-items: flex-start;
}

.manager-image,
.manager-placeholder {
  flex: 0 0 128rpx;
  width: 128rpx;
  height: 128rpx;
  margin-right: 20rpx;
  border-radius: 64rpx;
}

.manager-placeholder {
  line-height: 128rpx;
  background: #edf8f4;
  color: #1f8a70;
  text-align: center;
  font-weight: 800;
}

.manager-main,
.ayi-main {
  flex: 1;
  min-width: 0;
}

.manager-name,
.ayi-name {
  color: #1f2933;
  font-size: 31rpx;
  font-weight: 900;
}

.manager-title,
.ayi-meta {
  margin-top: 6rpx;
  color: #77818c;
  font-size: 25rpx;
}

.manager-intro {
  margin-top: 10rpx;
  color: #35424d;
  line-height: 1.55;
}

.team-summary,
.service-scope {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #f7faf9;
  color: #1f8a70;
  font-size: 28rpx;
  font-weight: 900;
}

.team-summary {
  margin-bottom: 16rpx;
}

.ayi-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.ayi-card:last-child {
  border-bottom: 0;
}

.ayi-photo,
.ayi-avatar {
  flex: 0 0 118rpx;
  width: 118rpx;
  height: 118rpx;
  margin-right: 18rpx;
  border-radius: 59rpx;
}

.ayi-avatar {
  line-height: 118rpx;
  color: #1f2933;
  text-align: center;
  font-size: 40rpx;
  font-weight: 900;
}

.ayi-head {
  display: flex;
  align-items: flex-start;
}

.featured-tag {
  background: #fff4f7;
  color: #d95e7a;
}

.ayi-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.price {
  color: #d45d3c;
  font-weight: 900;
}

.empty,
.empty-inline {
  padding: 70rpx 28rpx;
  text-align: center;
}

.empty-title {
  margin-bottom: 12rpx;
  color: #1f2933;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-inline {
  color: #77818c;
  font-size: 28rpx;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  margin-top: 28rpx;
  padding: 0;
  line-height: normal;
  border-radius: 42rpx;
}

.back-button::after {
  border: none;
}

.action-row {
  display: flex;
  margin-top: 24rpx;
}

.nav-button,
.call-button {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 38rpx;
  background: #edf8f4;
  color: #1f8a70;
  font-size: 28rpx;
  font-weight: 800;
}

.nav-button {
  margin-right: 16rpx;
}

.call-button {
  background: #fff4f7;
  color: #d95e7a;
}

.nav-button::after,
.call-button::after {
  border: none;
}
