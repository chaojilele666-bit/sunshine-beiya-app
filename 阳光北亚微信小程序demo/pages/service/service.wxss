.hero {
  padding: 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #e8f8f1 0%, #fff6e9 100%);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.city {
  flex: 0 0 auto;
  font-size: 32rpx;
  font-weight: 800;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 74rpx;
  padding: 0 22rpx;
  border-radius: 38rpx;
  background: #ffffff;
  border: 1rpx solid #edf0f2;
}

.search-icon {
  margin-right: 12rpx;
  color: #9aa3ad;
  font-size: 34rpx;
}

.search-box input {
  flex: 1;
  height: 70rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.feature-card {
  min-height: 120rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #fff4f7;
}

.feature-card.large {
  background: #e8f8f1;
}

.feature-title {
  color: #1f2933;
  font-size: 30rpx;
  font-weight: 800;
}

.feature-desc {
  margin-top: 10rpx;
  color: #77818c;
  font-size: 24rpx;
}

.eyebrow {
  color: #1f8a70;
  font-size: 26rpx;
  font-weight: 800;
}

.title {
  margin: 10rpx 0;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 800;
}

.hero-button {
  margin-top: 24rpx;
}

.hero-actions {
  display: grid;
  grid-template-columns: 1fr 180rpx;
  gap: 16rpx;
  margin-top: 24rpx;
}

.hero-actions .hero-button {
  margin-top: 0;
}

.type-scroll {
  margin: 24rpx 0 16rpx;
  white-space: nowrap;
}

.type-row {
  display: flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.type-pill {
  flex: 0 0 auto;
  min-width: 132rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background: #ffffff;
  color: #5d6873;
  text-align: center;
  font-size: 26rpx;
}

.type-pill.active {
  background: #1f8a70;
  color: #ffffff;
  font-weight: 800;
}

.filter-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin: 18rpx 0;
  padding: 8rpx 0;
}

.filter-item {
  color: #35424d;
  text-align: center;
  font-size: 28rpx;
}

.work-head {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.work-tile {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  background: #fff4f7;
  color: #d95e7a;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
}

.ayi-card,
.demand-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.ayi-card {
  display: flex;
  gap: 22rpx;
}

.avatar {
  flex: 0 0 128rpx;
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  border-radius: 64rpx;
  color: #1f2933;
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
}

.content {
  min-width: 0;
  flex: 1;
}

.topline,
.bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.name {
  margin-right: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.role-tag,
.status {
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
  background: #fff3df;
  color: #8b5d33;
  font-size: 22rpx;
}

.status {
  flex: 0 0 auto;
  background: #edf8f4;
  color: #1f8a70;
}

.rating,
.price {
  color: #d45d3c;
  font-weight: 800;
}

.info {
  margin-top: 14rpx;
  color: #35424d;
  line-height: 1.5;
}

.apply-button {
  margin-top: 22rpx;
}

.empty {
  padding: 40rpx 28rpx;
  text-align: center;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-button {
  margin-top: 28rpx;
}
