.search-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.city {
  flex: 0 0 auto;
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 800;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 74rpx;
  padding: 0 22rpx;
  border: 2rpx solid #f0b3c0;
  border-radius: 38rpx;
  background: #ffffff;
}

.search-icon {
  margin-right: 12rpx;
  color: #c7ccd1;
  font-size: 34rpx;
}

.search-box input {
  flex: 1;
  height: 70rpx;
}

.district-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.district {
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #7a7f87;
  text-align: center;
  font-size: 28rpx;
}

.district.active {
  border: 2rpx solid #f0b3c0;
  background: #fff4f7;
  color: #d95e7a;
  font-weight: 800;
}

.filter-row {
  display: flex;
  justify-content: flex-end;
  margin: 22rpx 0;
}

.stay-check {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #77818c;
}

.box {
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  border: 2rpx solid #d8dde3;
  border-radius: 8rpx;
  color: #1f8a70;
  text-align: center;
  font-size: 24rpx;
}

.stay-check.checked {
  color: #1f8a70;
  font-weight: 800;
}

.store-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.store-image {
  flex: 0 0 140rpx;
  width: 140rpx;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 10rpx;
  color: #1f8a70;
  text-align: center;
  font-weight: 800;
}

.store-main {
  min-width: 0;
  flex: 1;
}

.store-name {
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.tag-row {
  margin-top: 10rpx;
}

.store-tag {
  margin-right: 10rpx;
  color: #d95e7a;
  font-size: 24rpx;
}

.store-actions {
  flex: 0 0 96rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  justify-content: center;
}

.nav-button,
.call-button {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0;
  border-radius: 26rpx;
  background: #edf8f4;
  color: #1f8a70;
  font-size: 24rpx;
}

.call-button {
  background: #fff4f7;
  color: #d95e7a;
}

.empty {
  padding: 80rpx 30rpx;
  text-align: center;
}

.empty-icon {
  margin-bottom: 20rpx;
  color: #9aa3ad;
  font-size: 64rpx;
}

.empty-text {
  color: #5d6873;
  font-size: 30rpx;
}
